<%
  var comments = theme.comments || {};
  var enabled = comments.enable && comments.provider === 'utterances' && comments.repo;
  var issueTerm = comments.issue_term || 'pathname';
  var label = comments.label || 'comment';
  var lightTheme = comments.theme || 'github-light';
  var darkTheme = comments.dark_theme || 'github-dark';
%>
<% if (enabled) { %>
  <section
    class="post-comments"
    data-comment-provider="utterances"
    data-comment-light-theme="<%= lightTheme %>"
    data-comment-dark-theme="<%= darkTheme %>"
  >
    <h2 class="comments-title">COMMENTS</h2>
    <script>
      (function () {
        var container = document.currentScript.parentElement;
        var isDark = document.documentElement.classList.contains('theme-dark');
        var script = document.createElement('script');
        script.src = 'https://utteranc.es/client.js';
        script.setAttribute('repo', '<%= comments.repo %>');
        script.setAttribute('issue-term', '<%= issueTerm %>');
        script.setAttribute('label', '<%= label %>');
        script.setAttribute('theme', isDark ? '<%= darkTheme %>' : '<%= lightTheme %>');
        script.setAttribute('crossorigin', 'anonymous');
        script.async = true;
        container.appendChild(script);
      })();
    </script>
  </section>
<% } %>
